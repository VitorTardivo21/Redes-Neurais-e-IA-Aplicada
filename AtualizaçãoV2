"""
Etapa 2 — Extração, Limpeza e Normalização dos Textos
Projeto: Diário Oficial Inteligente de Avaré

ATIVIDADE 1: Extração de texto dos PDFs com pdfplumber
ATIVIDADE 2: Limpeza e normalização conservadora do texto
"""

import os
import re
import unicodedata
import pdfplumber
import pandas as pd

# ==========================================
# CONFIGURAÇÃO
# ==========================================

BASE_DIR        = os.path.dirname(os.path.abspath(__file__))
ARQUIVO_ENTRADA = os.path.join(BASE_DIR, "diarios_avare.csv")   # saída da Etapa 1
ARQUIVO_SAIDA   = os.path.join(BASE_DIR, "diarios_tratados.csv")
PASTA_PDFS      = os.path.join(BASE_DIR, "pdf")

# ==========================================
# ATIVIDADE 1 — EXTRAÇÃO DE TEXTO COM pdfplumber
# ==========================================

def extrair_texto_pdf(caminho_pdf: str) -> tuple[list[str], bool]:
    """
    Extrai o texto de cada página do PDF usando pdfplumber.

    Retorna:
        paginas  — lista com o texto de cada página (string vazia se branca)
        escaneado — True se NENHUMA página retornou texto (possível PDF escaneado)
    """
    paginas   = []
    com_texto = 0

    with pdfplumber.open(caminho_pdf) as pdf:
        for pagina in pdf.pages:
            texto = pagina.extract_text() or ""
            paginas.append(texto)
            if texto.strip():
                com_texto += 1

    escaneado = (com_texto == 0)
    return paginas, escaneado


# ==========================================
# ATIVIDADE 2 — LIMPEZA E NORMALIZAÇÃO
# ==========================================

def limpar_texto(texto: str) -> str:
    """
    Limpeza conservadora — mantém a estrutura do texto original.

    O que FAZ:
      - Remove espaços/tabs múltiplos (mas NÃO quebras de linha)
      - Reduz 3+ quebras de linha para 2
      - Remove linhas com apenas números (números de página do PDF)
      - Remove caracteres de controle invisíveis

    O que NÃO faz (conforme orientação do projeto):
      - Não remove acentos
      - Não converte para minúsculas
      - Não remove stopwords
      - Não colapsa tudo em uma única linha
    """
    # Espaços e tabs múltiplos → um único espaço
    texto = re.sub(r'[ \t]+', ' ', texto)

    # 3 ou mais quebras de linha → 2 (preserva parágrafo, remove excesso)
    texto = re.sub(r'\n{3,}', '\n\n', texto)

    # Linhas que contêm apenas números (números de página do PDF)
    texto = re.sub(r'^\s*\d+\s*$', '', texto, flags=re.MULTILINE)

    # Caracteres de controle (exceto \n e \r que são quebras de linha válidas)
    texto = re.sub(r'[\x00-\x08\x0b\x0c\x0e-\x1f]', '', texto)

    return texto.strip()


def normalizar_texto(texto: str) -> str:
    """
    Normalização Unicode e correções tipográficas.

    - Converte para forma NFC (padrão Unicode para português)
    - Corrige traço duplo e espaço não-separável
    - Substitui ligaduras tipográficas (ﬁ → fi, ﬂ → fl, etc.)
    """
    # Forma NFC — padrão estável para acentos em português
    texto = unicodedata.normalize('NFC', texto)

    # Traços e espaços problemáticos
    texto = texto.replace('--', '-')
    texto = texto.replace(' ', ' ')  # non-breaking space

    # Ligaduras tipográficas comuns em PDFs
    ligaduras = {
        'ﬀ': 'ff', 'ﬁ': 'fi', 'ﬂ': 'fl',
        'ﬃ': 'ffi', 'ﬄ': 'ffl', 'ﬅ': 'st', 'ﬆ': 'st',
    }
    for lig, sub in ligaduras.items():
        texto = texto.replace(lig, sub)

    return texto


def processar_texto(texto_bruto: str) -> str:
    """Aplica limpeza e normalização em sequência."""
    return normalizar_texto(limpar_texto(texto_bruto))


# ==========================================
# EXECUÇÃO PRINCIPAL
# ==========================================

print("Lendo metadados da Etapa 1...")
df_meta = pd.read_csv(ARQUIVO_ENTRADA, encoding="utf-8-sig")

# Monta mapa de (edicao, pagina) → linha de metadados da Etapa 1
# Usamos os metadados (data, url, etc.) da Etapa 1 e re-extraímos o texto com pdfplumber
edicoes_unicas = df_meta.drop_duplicates(subset=["edicao"])[
    ["edicao", "data", "paginas_total", "url"]
].copy()

print(f"  {len(edicoes_unicas)} edições para processar\n")

registros         = []
pdfs_escaneados   = []
paginas_em_branco = 0

for _, ed in edicoes_unicas.iterrows():

    edicao = str(ed["edicao"])
    data   = ed["data"]
    url    = ed["url"]
    total  = ed["paginas_total"]

    # Reconstrói o caminho local do PDF (mesmo padrão da Etapa 1)
    ano = data[:4]
    mes = data[5:7]
    nome_pdf    = f"{data}_{edicao}.pdf"
    caminho_pdf = os.path.join(PASTA_PDFS, ano, mes, nome_pdf)

    if not os.path.exists(caminho_pdf):
        print(f"  [AVISO] PDF não encontrado: {caminho_pdf}")
        continue

    print(f"Processando edição {edicao} ({data})...")

    # --------------------------------------------------
    # ATIVIDADE 1 — Extração com pdfplumber
    # --------------------------------------------------
    paginas, escaneado = extrair_texto_pdf(caminho_pdf)

    if escaneado:
        # PDF escaneado (imagem): pdfplumber retorna vazio em todas as páginas.
        # Solução correta seria OCR (pytesseract), documentado aqui para o relatório.
        print(f"  [ATENÇÃO] Edição {edicao}: PDF possivelmente escaneado — sem texto extraível.")
        print( "            Solução: pip install pytesseract pillow + Tesseract no sistema.")
        pdfs_escaneados.append({"edicao": edicao, "data": data, "caminho": caminho_pdf})
        continue

    # --------------------------------------------------
    # ATIVIDADE 2 — Limpeza e normalização por página
    # --------------------------------------------------
    for num_pag, texto_bruto in enumerate(paginas, start=1):

        if not texto_bruto.strip():
            paginas_em_branco += 1
            continue

        texto_final = processar_texto(texto_bruto)

        if not texto_final:
            paginas_em_branco += 1
            continue

        registros.append({
            "id":            f"{edicao}_{num_pag}",
            "data":          data,
            "edicao":        edicao,
            "pagina":        num_pag,
            "paginas_total": total,
            "url":           url,
            "conteudo":      texto_final,
        })

# ==========================================
# SALVAR CSV TRATADO
# ==========================================

df_saida = pd.DataFrame(registros)
df_saida.to_csv(ARQUIVO_SAIDA, index=False, encoding="utf-8-sig")

# ==========================================
# RELATÓRIO FINAL
# ==========================================

print("\n" + "=" * 45)
print("ETAPA 2 — CONCLUÍDA")
print("=" * 45)
print(f"Páginas com texto extraído : {len(df_saida)}")
print(f"Páginas em branco ignoradas: {paginas_em_branco}")
print(f"PDFs possivelmente escaneados: {len(pdfs_escaneados)}")
print(f"Arquivo de saída           : {ARQUIVO_SAIDA}")

if pdfs_escaneados:
    print("\nPDFs escaneados detectados (requerem OCR):")
    for p in pdfs_escaneados:
        print(f"  Edição {p['edicao']} — {p['data']}")

print("\nDistribuição do tamanho do conteúdo por página:")
tamanhos = df_saida["conteudo"].str.len()
print(f"  Mínimo : {tamanhos.min()} chars")
print(f"  Média  : {tamanhos.mean():.0f} chars")
print(f"  Máximo : {tamanhos.max()} chars")

print("\nExemplo — primeiros 500 chars da página 1 da 1ª edição:")
print(df_saida.iloc[0]["conteudo"][:500])
